<Window x:Class="OpenRemoteViewer.AdminNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification" Width="380" Height="110"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded">

    <Border CornerRadius="14" Margin="8" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.15" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid Margin="16,14,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon: soft mint tile; an eye for "screen is viewed", a glyph for other notices -->
                <Border Grid.Column="0" Width="40" Height="40" Background="#E3F6F1"
                        CornerRadius="11" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Grid>
                        <Viewbox x:Name="iconEye" Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="#0F9F85" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M2.5,12 C2.5,12 6,5.5 12,5.5 C18,5.5 21.5,12 21.5,12 C21.5,12 18,18.5 12,18.5 C6,18.5 2.5,12 2.5,12 Z"/>
                                <Ellipse Canvas.Left="9.2" Canvas.Top="9.2" Width="5.6" Height="5.6"
                                         Stroke="#0F9F85" StrokeThickness="1.7"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="txtNotifIcon" Visibility="Collapsed" FontSize="19"
                                   FontWeight="SemiBold" Foreground="#0F9F85"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtNotifTitle" Text="Admin connected"
                               FontSize="15" FontWeight="SemiBold" Foreground="#1a1d26"/>
                    <TextBlock x:Name="txtNotifMessage" Text="Your screen is being viewed"
                               FontSize="12" Foreground="#8a92a0" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Close button -->
                <Button Grid.Column="2" x:Name="btnClose"
                        Width="28" Height="28"
                        VerticalAlignment="Top" Margin="8,-2,-2,-2"
                        Click="BtnClose_Click" Cursor="Hand"
                        ToolTip="Close">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="8"
                                    Background="#0D000000" Width="28" Height="28">
                                <TextBlock Text="✕" FontSize="12"
                                           Foreground="#80000000"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#1FFF3C3C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
