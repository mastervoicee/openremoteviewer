<Window x:Class="OpenRemoteViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenRemoteViewer" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1e78ff" Offset="0"/>
            <GradientStop Color="#00c4a0" Offset="1"/>
        </LinearGradientBrush>

        <!-- Text input style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#f7f8fb"/>
            <Setter Property="Foreground" Value="#1a1d26"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="10,10,10,10"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#e8eaef"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#d0d5e0"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1e78ff"/>
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#f7f8fb"/>
            <Setter Property="Foreground" Value="#1a1d26"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="10,10,10,10"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#e8eaef"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#d0d5e0"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1e78ff"/>
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode button style -->
        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="7" Padding="8,8" Background="Transparent"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="dot" Width="7" Height="7" Fill="#d0d4dc" Margin="0,0,7,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="White"/>
                                <Setter TargetName="bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="dot" Property="Fill" Value="{StaticResource AccentGradient}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#f0f2f6"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bg" Property="Background" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#9aa0ac"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#1a1d26"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Checkbox style -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Cursor="Hand">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                    BorderThickness="1.5" BorderBrush="#d8dce6"
                                    Background="#f7f8fb" Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="check" Data="M3,9 L6.5,12.5 L14,4"
                                      Stroke="White" StrokeThickness="2"
                                      Visibility="Collapsed" Width="16" Height="16"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentGradient}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#1e78ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#555e6e"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="White" Margin="10"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.12" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#f8f9fc" CornerRadius="16,16,0,0"
                    BorderBrush="#0F000000" BorderThickness="0,0,0,1" Padding="16,12">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentGradient}"
                                Margin="0,0,10,0">
                            <TextBlock Text="⬚" Foreground="White" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="OpenRemoteViewer" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#333" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Click="BtnClose_Click" Cursor="Hand"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Width="22" Height="22" CornerRadius="11"
                                        Background="#0D000000">
                                    <TextBlock Text="✕" FontSize="11" Foreground="#4D000000"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#1FFF3C3C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="28,24,28,20" VerticalAlignment="Center">
                    <!-- Heading -->
                    <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold"
                               FontFamily="Consolas" Margin="0,0,0,2">
                        <Run Text="Open" Foreground="#1a1d26"/><Run Text="Remote">
                            <Run.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1e78ff" Offset="0"/>
                                    <GradientStop Color="#00c4a0" Offset="1"/>
                                </LinearGradientBrush>
                            </Run.Foreground>
                        </Run><Run Text="Viewer" Foreground="#1a1d26"/>
                    </TextBlock>
                    <TextBlock Text="S E C U R E   R E M O T E   A C C E S S" HorizontalAlignment="Center"
                               FontSize="9" Foreground="#aab0bc" Margin="0,0,0,22"
                               FontWeight="SemiBold"/>

                    <!-- Mode selector -->
                    <Border Background="#f2f4f8" CornerRadius="10" Padding="4" Margin="0,0,0,20">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="rbAdmin" Style="{StaticResource ModeButton}"
                                         GroupName="Role" Checked="Role_Changed" Unchecked="Role_Changed">
                                <TextBlock x:Name="txtRoleAdmin" Text="Admin"/>
                            </RadioButton>
                            <RadioButton x:Name="rbClient" Style="{StaticResource ModeButton}"
                                         GroupName="Role" IsChecked="True"
                                         Checked="Role_Changed" Unchecked="Role_Changed">
                                <TextBlock x:Name="txtRoleClient" Text="Client"/>
                            </RadioButton>
                        </UniformGrid>
                    </Border>

                    <!-- IP + Port row -->
                    <Grid x:Name="panelIP" Margin="0,0,0,14" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="lblIP" Text="IP ADDRESS" Style="{x:Null}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#9aa0ac"
                                       Margin="0,0,0,7"/>
                            <TextBox x:Name="txtIP" Style="{StaticResource ModernTextBox}"
                                     Text="192.168.1."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="lblPort" Text="PORT" Style="{x:Null}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#9aa0ac"
                                       Margin="0,0,0,7"/>
                            <TextBox x:Name="txtPort" Style="{StaticResource ModernTextBox}"
                                     Text="9876"/>
                        </StackPanel>
                    </Grid>

                    <!-- Port only (client mode) -->
                    <StackPanel x:Name="panelPortOnly" Margin="0,0,0,14">
                        <TextBlock x:Name="lblPortOnly" Text="PORT" Style="{x:Null}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#9aa0ac"
                                   Margin="0,0,0,7"/>
                        <TextBox x:Name="txtPortClient" Style="{StaticResource ModernTextBox}"
                                 Text="9876"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock x:Name="lblPassword" Text="PASSWORD" Style="{x:Null}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#9aa0ac"
                                   Margin="0,0,0,7"/>
                        <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBox}"/>
                    </StackPanel>

                    <!-- Language dropdown -->
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock x:Name="lblLanguage" Text="LANGUAGE" Style="{x:Null}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#9aa0ac"
                                   Margin="0,0,0,7"/>
                        <Border Background="#f7f8fb" BorderBrush="#e8eaef" BorderThickness="1.5"
                                CornerRadius="9">
                            <ComboBox x:Name="cmbLanguage" FontSize="13" Padding="8,8"
                                      Background="Transparent" BorderThickness="0"
                                      SelectionChanged="Language_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Flag}" Margin="0,0,8,0" FontSize="15"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       FontSize="13" Foreground="#1a1d26"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <!-- Checkboxes -->
                    <StackPanel Margin="0,0,0,20">
                        <CheckBox x:Name="chkRemember" Style="{StaticResource ModernCheckBox}"
                                  Margin="0,0,0,10">
                            <TextBlock x:Name="txtRemember" Text="Remember settings and password"/>
                        </CheckBox>
                        <CheckBox x:Name="chkAutoStart" Style="{StaticResource ModernCheckBox}">
                            <TextBlock x:Name="txtAutoStart" Text="Auto-start with Windows"/>
                        </CheckBox>
                    </StackPanel>

                    <!-- Submit -->
                    <Button x:Name="btnStart" Click="BtnStart_Click" Cursor="Hand" Height="44">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="10"
                                        Background="{StaticResource AccentGradient}"
                                        Padding="13">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4"
                                                          Opacity="0.25" Color="#1e78ff"/>
                                    </Border.Effect>
                                    <TextBlock x:Name="txt" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                               HorizontalAlignment="Center" FontSize="14"
                                               FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.93"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
            </StackPanel>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="#f8f9fc" CornerRadius="0,0,16,16"
                    BorderBrush="#0D000000" BorderThickness="0,1,0,0" Padding="16,10">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,8,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#00c4a0"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="txtStatus" FontSize="11" Foreground="#aab0bc"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                    <Button x:Name="btnUpdate" DockPanel.Dock="Right" Content="v1.0.0"
                            Padding="10,3" FontSize="11" Cursor="Hand"
                            Background="#E9ECF3" Foreground="#4b5563" BorderThickness="0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
