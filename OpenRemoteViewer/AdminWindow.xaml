<Window x:Class="OpenRemoteViewer.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenRemoteViewer — Админ" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="txtScreenLabel" Text="Screen:" VerticalAlignment="Center"
                           Foreground="#CCC" Margin="4,0,8,0" FontSize="13"/>
                <StackPanel x:Name="pnlMonitors" Orientation="Horizontal"
                            VerticalAlignment="Center"/>
                <TextBlock x:Name="txtFps" Text="FPS: —"
                           VerticalAlignment="Center" Foreground="#AAA"
                           Margin="18,0,0,0" FontSize="13"/>
                <TextBlock x:Name="txtClickHint" Text="  |  Click on screen to mark a point"
                           VerticalAlignment="Center" Foreground="#777"
                           Margin="10,0,0,0" FontSize="12"/>
                <Button x:Name="btnDisconnect" Content="Disconnect"
                        VerticalAlignment="Center" Margin="20,0,0,0"
                        Padding="12,3" FontSize="12" Cursor="Hand"
                        Background="#D32F2F" Foreground="White" BorderThickness="0"
                        Click="BtnDisconnect_Click"/>
                <Button x:Name="btnUpdate" Content="Update" Visibility="Collapsed"
                        VerticalAlignment="Center" Margin="10,0,0,0"
                        Padding="12,3" FontSize="12" Cursor="Hand"
                        Background="#2E7D32" Foreground="White" BorderThickness="0"
                        Click="BtnUpdate_Click"/>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#007ACC" Foreground="White">
            <TextBlock x:Name="txtAdminStatus" Text="Connecting..."
                       FontSize="12"/>
        </StatusBar>

        <Border Background="#111">
            <Grid Background="Transparent"
                  MouseLeftButtonDown="ImgScreen_MouseLeftButtonDown"
                  MouseRightButtonDown="Screen_MouseRightButtonDown"
                  MouseRightButtonUp="Screen_MouseRightButtonUp"
                  MouseMove="Screen_MouseMove"
                  LostMouseCapture="Screen_LostMouseCapture"
                  Cursor="Cross">
                <Image x:Name="imgScreen" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="LowQuality"/>
                <Canvas x:Name="canvasDraw" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
